# Card identification: "mock" (no key needed), "claude" (needs ANTHROPIC_API_KEY),
# or "ebay" (eBay image search; uses the EBAY_* keys below, set EBAY_MODE=live for real matches)
IDENTIFIER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# eBay: "mock" (no keys needed) or "live"
EBAY_MODE=mock
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Needed only for posting listings (user-consent OAuth token with sell.inventory scope)
EBAY_USER_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

DATABASE_URL=sqlite:///./data/cardvault.db
IMAGE_DIR=./data/images
CORS_ORIGINS=http://localhost:3000
# Public https URL that serves /images (e.g. a tunnel); eBay must be able to fetch photos
PUBLIC_BASE_URL=
